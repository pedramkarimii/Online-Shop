# -----------------------------------------------------------------------------
# Local development configuration
# Copy this file to .env and replace all placeholder values.
# Never commit .env or real credentials.
# -----------------------------------------------------------------------------

# Django
DEBUG=true
SECRET_KEY=django-insecure-local-development-only-change-me
TIME_ZONE=UTC
LOG_FILE_PATH=/tmp/online-shop.log

# PostgreSQL
DB_NAME=online_shop
DB_USER=online_shop
DB_PASSWORD=change-me-for-local-development
DB_HOST=db
DB_PORT=5432
POSTGRES_HOST_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_HOST_PORT=6380

# RabbitMQ
RABBITMQ_USER=app
RABBITMQ_PASSWORD=change-me-for-local-development
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672

# Celery
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Django application
API_PORT=8000
API_HOST_PORT=8000
API_LOG_LEVEL=info
API_WORKERS=2
API_THREADS=2

# Docker user mapping
# Set these to your host values: id -u and id -g
LOCAL_UID=1000
LOCAL_GID=1000

# Local email backend
DEBUG_DEFAULT_FROM_EMAIL=dev@example.com
DEBUG_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEBUG_EMAIL_HOST=localhost
DEBUG_EMAIL_HOST_USER=
DEBUG_EMAIL_HOST_PASSWORD=
DEBUG_EMAIL_PORT=1025
DEBUG_EMAIL_USE_SSL=false
DEBUG_EMAIL_USE_TLS=false

# Production email placeholders
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_PORT=587
EMAIL_USE_SSL=false
EMAIL_USE_TLS=true

# Object storage placeholders
# Keep these placeholder values for local development unless object storage is enabled.
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
AWS_SERVICE_NAME=s3
AWS_STORAGE_BUCKET_NAME=replace-me
AWS_S3_ENDPOINT_URL=https://s3.example.com
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_FILE_OVERWRITE=false
